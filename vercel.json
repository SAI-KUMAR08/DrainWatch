{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/drainwatch run build",
  "outputDirectory": "artifacts/drainwatch/dist",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs24.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}